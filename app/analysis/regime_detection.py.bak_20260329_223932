"""
regime_detection.py
Part of the app/analysis module.
Detects market regimes (trending, ranging, volatile, etc.)
"""

import pandas as pd
import numpy as np
from typing import Dict, List, Tuple, Optional
from enum import Enum
from sklearn.mixture import GaussianMixture
from scipy import stats


class MarketRegime(Enum):
    """Market regime types"""
    STRONG_TREND_UP = "strong_trend_up"
    WEAK_TREND_UP = "weak_trend_up"
    STRONG_TREND_DOWN = "strong_trend_down"
    WEAK_TREND_DOWN = "weak_trend_down"
    RANGING = "ranging"
    HIGH_VOLATILITY = "high_volatility"
    LOW_VOLATILITY = "low_volatility"
    BREAKOUT = "breakout"
    MEAN_REVERTING = "mean_reverting"


class MarketRegimeDetector:
    """Detects market regimes using multiple indicators"""
    
    def __init__(self, window: int = 100):
        """
        Initialize regime detector
        
        Args:
            window: Lookback window for regime detection
        """
        self.window = window
        self.current_regime = None
        self.regime_history = []
        
    def detect_regime(self, data: pd.DataFrame) -> Dict:
        """
        Detect current market regime
        
        Args:
            data: DataFrame with OHLCV data
        
        Returns:
            Dictionary with regime detection results
        """
        if len(data) < self.window:
            return {'regime': MarketRegime.RANGING, 'confidence': 0.5}
        
        # Calculate regime features
        features = self._calculate_features(data)
        
        # Determine regime based on features
        regime = self._classify_regime(features, data)
        
        # Calculate confidence
        confidence = self._calculate_confidence(regime, features)
        
        # Get regime transitions
        transitions = self._detect_transitions(data)
        
        result = {
            'regime': regime.value,
            'confidence': confidence,
            'features': features,
            'transitions': transitions,
            'is_trending': regime in [MarketRegime.STRONG_TREND_UP, MarketRegime.WEAK_TREND_UP,
                                       MarketRegime.STRONG_TREND_DOWN, MarketRegime.WEAK_TREND_DOWN],
            'direction': 'up' if 'up' in regime.value else 'down' if 'down' in regime.value else 'neutral'
        }
        
        self.current_regime = result
        self.regime_history.append(result)
        
        return result
    
    def _calculate_features(self, data: pd.DataFrame) -> Dict:
        """Calculate features for regime detection"""
        close = data['close']
        returns = close.pct_change().dropna()
        
        # Trend features
        sma_20 = close.rolling(20).mean()
        sma_50 = close.rolling(50).mean()
        
        # Volatility features
        historical_vol = returns.rolling(20).std() * np.sqrt(252)
        avg_vol = historical_vol.mean()
        
        # Range features
        atr = self._calculate_atr(data)
        avg_range = data['high'] - data['low']
        
        # Momentum features
        rsi = self._calculate_rsi(close)
        
        # Volume features
        volume_ratio = data['volume'] / data['volume'].rolling(20).mean()
        
        features = {
            'trend_strength': abs(sma_20.iloc[-1] / sma_50.iloc[-1] - 1),
            'trend_direction': np.sign(sma_20.iloc[-1] - sma_50.iloc[-1]),
            'volatility': historical_vol.iloc[-1] / avg_vol if avg_vol > 0 else 1,
            'avg_range': avg_range.iloc[-20:].mean(),
            'rsi': rsi.iloc[-1],
            'volume_surge': volume_ratio.iloc[-1],
            'correlation': returns.autocorr(lag=1),
            'kurtosis': returns.kurtosis(),
            'skewness': returns.skew()
        }
        
        return features
    
    def _classify_regime(self, features: Dict, data: pd.DataFrame) -> MarketRegime:
        """Classify market regime based on features"""
        trend_strength = features['trend_strength']
        trend_dir = features['trend_direction']
        volatility = features['volatility']
        rsi = features['rsi']
        
        # Trend regimes
        if trend_strength > 0.05:  # Strong trend
            if trend_dir > 0:
                if rsi > 70:
                    return MarketRegime.STRONG_TREND_UP
                else:
                    return MarketRegime.WEAK_TREND_UP
            else:
                if rsi < 30:
                    return MarketRegime.STRONG_TREND_DOWN
                else:
                    return MarketRegime.WEAK_TREND_DOWN
        
        # Volatility regimes
        if volatility > 1.5:
            return MarketRegime.HIGH_VOLATILITY
        elif volatility < 0.5:
            return MarketRegime.LOW_VOLATILITY
        
        # Check for ranging
        if trend_strength < 0.02 and 30 < rsi < 70:
            # Check if price is within a range
            price_range = (data['high'].tail(50).max() - data['low'].tail(50).min()) / data['close'].tail(50).mean()
            if price_range < 0.05:
                return MarketRegime.RANGING
        
        # Check for mean reversion
        if abs(features['correlation']) > 0.3 and features['kurtosis'] > 3:
            return MarketRegime.MEAN_REVERTING
        
        # Check for breakout
        if features['volume_surge'] > 2 and trend_strength > 0.03:
            return MarketRegime.BREAKOUT
        
        return MarketRegime.RANGING
    
    def _calculate_confidence(self, regime: MarketRegime, features: Dict) -> float:
        """Calculate confidence in regime classification"""
        confidence = 0.5
        
        if regime in [MarketRegime.STRONG_TREND_UP, MarketRegime.STRONG_TREND_DOWN]:
            confidence = min(0.9, 0.5 + features['trend_strength'])
        elif regime == MarketRegime.RANGING:
            confidence = 0.7 if features['trend_strength'] < 0.01 else 0.5
        elif regime == MarketRegime.HIGH_VOLATILITY:
            confidence = min(0.85, 0.5 + (features['volatility'] - 1) / 2)
        elif regime == MarketRegime.BREAKOUT:
            confidence = min(0.8, 0.5 + features['volume_surge'] / 4)
        
        return min(0.95, max(0.3, confidence))
    
    def _detect_transitions(self, data: pd.DataFrame) -> List[Dict]:
        """Detect regime transitions"""
        transitions = []
        
        if len(self.regime_history) > 1:
            prev_regime = self.regime_history[-2]['regime']
            curr_regime = self.current_regime['regime'] if self.current_regime else None
            
            if curr_regime and prev_regime != curr_regime:
                transitions.append({
                    'from': prev_regime,
                    'to': curr_regime,
                    'timestamp': data.index[-1].isoformat()
                })
        
        return transitions
    
    def _calculate_atr(self, data: pd.DataFrame, period: int = 14) -> pd.Series:
        """Calculate Average True Range"""
        high = data['high']
        low = data['low']
        close = data['close'].shift(1)
        
        tr1 = high - low
        tr2 = abs(high - close)
        tr3 = abs(low - close)
        
        true_range = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)
        atr = true_range.rolling(window=period).mean()
        
        return atr
    
    def _calculate_rsi(self, close: pd.Series, period: int = 14) -> pd.Series:
        """Calculate RSI"""
        delta = close.diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()
        rs = gain / loss
        rsi = 100 - (100 / (1 + rs))
        return rsi
    
    def get_regime_metrics(self) -> Dict:
        """Get historical regime metrics"""
        if not self.regime_history:
            return {}
        
        regime_counts = {}
        for record in self.regime_history:
            regime = record['regime']
            regime_counts[regime] = regime_counts.get(regime, 0) + 1
        
        return {
            'total_transitions': len(self.regime_history) - 1,
            'regime_distribution': regime_counts,
            'current_regime': self.current_regime
        }