import pandas as pd
"""
sentiment_analysis.py
Part of the app/analysis module.
Analyzes sentiment from news, social media, and market data.
"""

import re
from typing import Dict, List, Optional, Any
from datetime import datetime, timedelta
from dataclasses import dataclass
from enum import Enum


class SentimentScore(Enum):
    """Sentiment classification"""
    VERY_BEARISH = -2
    BEARISH = -1
    NEUTRAL = 0
    BULLISH = 1
    VERY_BULLISH = 2


@dataclass
class SentimentSource:
    """Container for sentiment from a single source"""
    source: str
    score: float
    confidence: float
    timestamp: datetime
    text_sample: Optional[str] = None
    url: Optional[str] = None


class SentimentAnalyzer:
    """Multi-source sentiment analysis for market intelligence"""
    
    def __init__(self):
        """Initialize sentiment analyzer"""
        self.sentiment_history = []
        self.sentiment_weights = {
            'news': 0.4,
            'social': 0.3,
            'technical': 0.2,
            'onchain': 0.1
        }
        
        # Sentiment keywords
        self.bullish_keywords = {
            'bullish', 'rally', 'surge', 'pump', 'moon', 'breakout', 'upside',
            'positive', 'gain', 'growth', 'opportunity', 'buy', 'accumulate',
            'strong', 'momentum', 'support', 'resistance_break'
        }
        
        self.bearish_keywords = {
            'bearish', 'crash', 'dump', 'plunge', 'drop', 'breakdown', 'downside',
            'negative', 'loss', 'risk', 'sell', 'liquidate', 'weak', 'reversal',
            'resistance', 'correction'
        }
        
        self.intensity_modifiers = {
            'very': 1.5,
            'extremely': 2.0,
            'slightly': 0.5,
            'moderately': 0.8,
            'strongly': 1.3
        }
    
    def analyze_text(self, text: str, source: str = 'news') -> Dict:
        """
        Analyze sentiment from text
        
        Args:
            text: Text content to analyze
            source: Source of text (news, social, etc.)
        
        Returns:
            Sentiment analysis result
        """
        text_lower = text.lower()
        
        # Count keywords
        bullish_count = sum(1 for word in self.bullish_keywords if word in text_lower)
        bearish_count = sum(1 for word in self.bearish_keywords if word in text_lower)
        
        # Apply intensity modifiers
        for modifier, multiplier in self.intensity_modifiers.items():
            if modifier in text_lower:
                if any(word in text_lower for word in self.bullish_keywords):
                    bullish_count *= multiplier
                if any(word in text_lower for word in self.bearish_keywords):
                    bearish_count *= multiplier
        
        # Calculate base score
        total_words = bullish_count + bearish_count
        if total_words > 0:
            raw_score = (bullish_count - bearish_count) / total_words
        else:
            raw_score = 0
        
        # Normalize to [-1, 1]
        score = max(-1, min(1, raw_score))
        
        # Calculate confidence
        confidence = min(0.9, total_words / 20) if total_words > 0 else 0.1
        
        # Determine classification
        if score > 0.7:
            sentiment = SentimentScore.VERY_BULLISH
        elif score > 0.2:
            sentiment = SentimentScore.BULLISH
        elif score < -0.7:
            sentiment = SentimentScore.VERY_BEARISH
        elif score < -0.2:
            sentiment = SentimentScore.BEARISH
        else:
            sentiment = SentimentScore.NEUTRAL
        
        result = {
            'score': score,
            'sentiment': sentiment.name,
            'sentiment_value': sentiment.value,
            'confidence': confidence,
            'bullish_count': bullish_count,
            'bearish_count': bearish_count,
            'source': source
        }
        
        # Store in history
        self.sentiment_history.append({
            **result,
            'timestamp': datetime.now(),
            'text_sample': text[:200]
        })
        
        return result
    
    def aggregate_sentiment(self, sources: List[SentimentSource]) -> Dict:
        """
        Aggregate sentiment from multiple sources
        
        Args:
            sources: List of SentimentSource objects
        
        Returns:
            Aggregated sentiment result
        """
        if not sources:
            return {
                'overall_score': 0,
                'confidence': 0,
                'sentiment': 'NEUTRAL',
                'sources_analyzed': 0
            }
        
        weighted_score = 0
        weighted_confidence = 0
        total_weight = 0
        
        for source in sources:
            weight = self.sentiment_weights.get(source.source.lower(), 0.25)
            total_weight += weight
            
            weighted_score += source.score * weight
            weighted_confidence += source.confidence * weight
        
        overall_score = weighted_score / total_weight if total_weight > 0 else 0
        avg_confidence = weighted_confidence / total_weight if total_weight > 0 else 0
        
        # Determine overall sentiment
        if overall_score > 0.6:
            sentiment = 'VERY_BULLISH'
        elif overall_score > 0.2:
            sentiment = 'BULLISH'
        elif overall_score < -0.6:
            sentiment = 'VERY_BEARISH'
        elif overall_score < -0.2:
            sentiment = 'BEARISH'
        else:
            sentiment = 'NEUTRAL'
        
        return {
            'overall_score': overall_score,
            'confidence': avg_confidence,
            'sentiment': sentiment,
            'sources_analyzed': len(sources),
            'source_breakdown': [
                {
                    'source': s.source,
                    'score': s.score,
                    'confidence': s.confidence
                }
                for s in sources
            ]
        }
    
    def detect_sentiment_shifts(self, lookback_hours: int = 24) -> Dict:
        """
        Detect shifts in sentiment over time
        
        Args:
            lookback_hours: Hours to look back for shift detection
        
        Returns:
            Sentiment shift analysis
        """
        cutoff_time = datetime.now() - timedelta(hours=lookback_hours)
        recent_history = [
            h for h in self.sentiment_history 
            if h['timestamp'] > cutoff_time
        ]
        
        if len(recent_history) < 2:
            return {'shift_detected': False, 'message': 'Insufficient data'}
        
        # Calculate recent average sentiment
        recent_scores = [h['score'] for h in recent_history[-10:]]
        older_scores = [h['score'] for h in recent_history[:-10]] if len(recent_history) > 10 else recent_history[:len(recent_history)//2]
        
        current_avg = sum(recent_scores) / len(recent_scores) if recent_scores else 0
        previous_avg = sum(older_scores) / len(older_scores) if older_scores else current_avg
        
        # Detect shift
        shift_magnitude = current_avg - previous_avg
        shift_detected = abs(shift_magnitude) > 0.3
        
        shift_direction = 'positive' if shift_magnitude > 0 else 'negative' if shift_magnitude < 0 else 'neutral'
        
        return {
            'shift_detected': shift_detected,
            'shift_magnitude': shift_magnitude,
            'shift_direction': shift_direction,
            'current_sentiment': current_avg,
            'previous_sentiment': previous_avg,
            'current_classification': self._score_to_classification(current_avg),
            'previous_classification': self._score_to_classification(previous_avg)
        }
    
    def _score_to_classification(self, score: float) -> str:
        """Convert sentiment score to classification"""
        if score > 0.6:
            return 'VERY_BULLISH'
        elif score > 0.2:
            return 'BULLISH'
        elif score < -0.6:
            return 'VERY_BEARISH'
        elif score < -0.2:
            return 'BEARISH'
        else:
            return 'NEUTRAL'
    
    def analyze_market_indicators(self, data: pd.DataFrame) -> Dict:
        """
        Derive sentiment from market indicators
        
        Args:
            data: OHLCV data
        
        Returns:
            Sentiment from market indicators
        """
        if len(data) < 20:
            return {'score': 0, 'confidence': 0.2, 'sentiment': 'NEUTRAL'}
        
        # Technical indicators that indicate sentiment
        close = data['close']
        volume = data['volume']
        
        # Price momentum (last 20 periods)
        price_change = (close.iloc[-1] - close.iloc[-20]) / close.iloc[-20]
        price_momentum_score = max(-1, min(1, price_change * 10))
        
        # Volume sentiment (increasing volume on up days)
        up_days = (close.diff() > 0).tail(20)
        volume_on_up_days = volume.tail(20)[up_days].mean() if up_days.any() else 0
        volume_on_down_days = volume.tail(20)[~up_days].mean() if (~up_days).any() else 0
        
        volume_sentiment = (volume_on_up_days - volume_on_down_days) / (volume_on_up_days + volume_on_down_days + 1e-6)
        volume_sentiment_score = max(-1, min(1, volume_sentiment))
        
        # RSI sentiment
        rsi = self._calculate_rsi(close, 14)
        if rsi.iloc[-1] > 70:
            rsi_score = -0.5  # Overbought = bearish sentiment
        elif rsi.iloc[-1] < 30:
            rsi_score = 0.5  # Oversold = bullish sentiment
        else:
            rsi_score = 0
        
        # Combine scores
        combined_score = (price_momentum_score * 0.5 + 
                         volume_sentiment_score * 0.3 + 
                         rsi_score * 0.2)
        
        confidence = min(0.8, abs(combined_score) + 0.2)
        
        return {
            'score': combined_score,
            'confidence': confidence,
            'sentiment': self._score_to_classification(combined_score),
            'components': {
                'price_momentum': price_momentum_score,
                'volume_sentiment': volume_sentiment_score,
                'rsi_sentiment': rsi_score
            }
        }
    
    def _calculate_rsi(self, close: pd.Series, period: int = 14) -> pd.Series:
        """Calculate RSI"""
        delta = close.diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()
        rs = gain / loss
        rsi = 100 - (100 / (1 + rs))
        return rsi