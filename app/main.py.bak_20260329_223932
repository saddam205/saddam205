#-------------------------------------------------------------------------------


# Main entry point
if __name__ == "__main__":
    import uvicorn
    
    # Setup logging
    setup_logger()
    
    # Run application
    uvicorn.run(
        "app.main:app",
        host=config.API_HOST,
        port=config.API_PORT,
        reload=config.API_RELOAD,
        log_level=config.LOG_LEVEL.lower()
    )